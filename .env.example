# =============================================================================
# GenAI RCA POC Environment Configuration
# =============================================================================

# LLM Provider Configuration
# Set to "gemini" to use Google AI Studio Gemini API, or "ollama" for local LLM
LLM_PROVIDER=gemini

# Google AI Studio API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-flash-latest


# (Optional) Override Router & Synthesis Models
# ROUTER_MODEL=gemini-2.0-flash
# SYNTHESIS_MODEL=gemini-2.0-flash

# Base URLs
MCP_BASE_URL=http://localhost:8001
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
