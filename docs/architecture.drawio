        <mxCell id="edge_poller_orch" value="3. POST /api/v1/internal/analyze_incident" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node_poller" target="container_orchestrator">
