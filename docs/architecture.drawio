        <mxCell id="edge_poller_mcp" value="1. POST /tools/find_new_errors&#xa;2. POST /tools/get_trace_by_logging_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node_poller" target="container_mcp">
