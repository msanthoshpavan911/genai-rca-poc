        <!-- TITLE CONTAINER -->
        <mxCell id="title_box" value="GenAI Log Analysis &amp; Root Cause Analysis (RCA) Assistant&#xa;Technical Architecture &amp; Component Interaction Diagram" style="shape=mxgraph.basic.rectangle;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;fontSize=18;fontStyle=1;alignment=center;verticalAlignment=middle;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="60" as="geometry" />
        </mxCell>

        <!-- CONTAINER 1: EXISTING CLIENT INFRASTRUCTURE -->
        <mxCell id="container_client_infra" value="EXISTING CLIENT INFRASTRUCTURE (Read-Only Target)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;fontStyle=1;startSize=30;rounded=1;dashed=1;" vertex="1" parent="1">
