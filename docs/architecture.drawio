        <mxCell id="edge_dispatch_email" value="Send Email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="container_monitor" source="node_alert_dispatch" target="node_channel_email">
          <mxGeometry relative="1" as="geometry" />
