        <mxCell id="edge_poller_redis" value="Read/Write Checkpoints &amp; Dedup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_poller" target="node_redis">
